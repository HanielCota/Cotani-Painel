# Supabase - Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Supavisor Transaction (porta 6543) para a aplicação/Vercel.
SUPABASE_DATABASE_URL="postgresql://postgres.PROJECT_REF:SENHA@HOST:6543/postgres?pgbouncer=true&uselibpqcompat=true&sslmode=require"
# Supavisor Session (porta 5432) para migrations.
SUPABASE_DIRECT_URL="postgresql://postgres.PROJECT_REF:SENHA@HOST:5432/postgres?uselibpqcompat=true&sslmode=require"
DATABASE_POOL_MAX=3

# UUIDs do Supabase Auth autorizados a acessar /admin, separados por vírgula.
PLATFORM_ADMIN_USER_IDS=

# Vercel Cron - autorização dos jobs de notificações, cobrança e manutenção
# Gere um segredo forte: openssl rand -hex 32
# Obrigatório em produção.
CRON_SECRET=

# Modo de envio de WhatsApp:
# - "manual": o profissional envia manualmente via wa.me no CRM de comunicações (padrão, sem custo)
# - "api": envio automático por API (requer provedor configurado em message-sender.ts)
WHATSAPP_SENDER_MODE=manual

# Necessárias somente quando WHATSAPP_SENDER_MODE=api (Meta Cloud API).
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=v23.0
META_WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
# Modelo Utility aprovado com o corpo "Mensagem da Cotani sobre seu agendamento: {{1}}".
META_WHATSAPP_APPOINTMENT_TEMPLATE=
META_WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

# E-mail transacional (Resend).
RESEND_API_KEY=
EMAIL_FROM=Cotani <agendamentos@cotani.com.br>

# SMS, utilizado apenas pelo plano Empresa (Twilio).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=

# URL pública deste ambiente. Use localhost no .env.local; na Vercel, configure
# https://painel.cotani.com.br diretamente nas variáveis do projeto.
# Usada em links de cancelamento e retorno de checkout.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Origem autorizada a iniciar e consultar o checkout público.
LANDING_PAGE_URL=http://localhost:4321

# Opcional: ative somente depois de habilitar o Web Analytics no projeto da Vercel.
NEXT_PUBLIC_VERCEL_ANALYTICS_ENABLED=false

# Defina como production apenas fora da Vercel em uma hospedagem própria.
# A Vercel fornece VERCEL_ENV automaticamente.
APP_ENV=development

# Mercado Pago - https://www.mercadopago.com.br/developers/panel
# Access token da conta do vendedor (produção ou teste).
MERCADO_PAGO_ACCESS_TOKEN=
# Secret usado para validar a assinatura das notificações webhook (header x-signature).
# Opcional em desenvolvimento; obrigatório em produção.
MERCADO_PAGO_WEBHOOK_SECRET=
# IDs retornados pela API preapproval_plan. Cada ID deve pertencer ao mesmo
# ambiente do Access Token acima (todos de teste ou todos de produção).
MERCADO_PAGO_ESSENTIAL_MONTHLY_PLAN_ID=
MERCADO_PAGO_ESSENTIAL_ANNUAL_PLAN_ID=
MERCADO_PAGO_PROFESSIONAL_MONTHLY_PLAN_ID=
MERCADO_PAGO_PROFESSIONAL_ANNUAL_PLAN_ID=
SUBSCRIPTION_GRACE_PERIOD_DAYS=3

# Cloudflare Turnstile. A chave pública também é usada nas telas de Auth.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Tentativas de checkout nunca pagas são anonimizadas por este cron diário.
ABANDONED_CHECKOUT_RETENTION_DAYS=30
