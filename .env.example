# Clerk — https://dashboard.clerk.com → API keys
# Em produção, use as chaves da instância "Production" (pk_live_/sk_live_).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk → Webhooks → signing secret do endpoint https://SEU-DOMINIO/api/webhooks/clerk
CLERK_WEBHOOK_SIGNING_SECRET=

# PostgreSQL (Neon) — em produção, use a connection string pooled (-pooler) com sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/cotani?schema=public"

# Fila de notificações (Vercel Cron → GET /api/jobs/notifications)
# Gere um segredo forte: openssl rand -hex 32
CRON_SECRET=

# Não existe sign-up público: contas são provisionadas via API após o pagamento.
# Todo redirect de autenticação aponta para a página de login customizada.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# URL pública da aplicação, usada em links de cancelamento enviados por WhatsApp/E-mail
NEXT_PUBLIC_APP_URL=https://localhost:3000

# URL de checkout/landing page para renovação/contratação de plano.
# Será substituída por checkout interno no painel no futuro.
NEXT_PUBLIC_CHECKOUT_URL=https://cotani-landingpage.vercel.app/checkout?plano=iniciante&ciclo=mensal

# Mercado Pago — https://www.mercadopago.com.br/developers/panel
# Access token da conta do vendedor (produção ou teste).
MERCADO_PAGO_ACCESS_TOKEN=
# Secret usado para validar a assinatura das notificações webhook (header x-signature).
# Opcional em desenvolvimento; obrigatório em produção.
MERCADO_PAGO_WEBHOOK_SECRET=
# IDs dos planos de assinatura criados no painel do Mercado Pago (preapproval_plan).
# Mensal: R$ 97,00 / Anual: R$ 970,00
MERCADO_PAGO_MONTHLY_PLAN_ID=
MERCADO_PAGO_ANNUAL_PLAN_ID=

# Dados fictícios no dashboard para validação de layout em desenvolvimento
ENABLE_DASHBOARD_MOCKS=false
