generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ClinicRole {
  ADMIN
  PROVIDER
  RECEPTIONIST
}

enum ClinicOperationalStatus {
  ACTIVE
  SUSPENDED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  INACTIVE
  PAST_DUE
  CANCELED
}

enum SubscriptionPlan {
  ESSENTIAL
  PROFESSIONAL
  ENTERPRISE
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELED
  NO_SHOW
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  CASH
  OTHER
}

enum FinancialEntryType {
  INCOME
  EXPENSE
}

enum FinancialEntryStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
  CANCELED
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
  SMS
}

enum NotificationKind {
  CONFIRMATION
  REMINDER_24H
  REMINDER_2H
  RESCHEDULE_RESPONSE
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  CANCELED
}

model Clinic {
  id                           String                  @id @default(uuid())
  legacyExternalId             String?                 @unique
  billingOwnerId               String?
  name                         String
  slug                         String                  @unique
  timeZone                     String                  @default("America/Sao_Paulo")
  contactEmail                 String?
  phone                        String?
  address                      String?
  publicDescription            String?
  imageUrl                     String?
  subscriptionStatus           SubscriptionStatus      @default(INACTIVE)
  subscriptionPlan             SubscriptionPlan?
  subscriptionCycle            BillingCycle?
  pendingSubscriptionPlan      SubscriptionPlan?
  pendingSubscriptionCycle     BillingCycle?
  trialEndsAt                  DateTime?
  subscriptionExpiresAt        DateTime?
  hasPaidOnce                  Boolean                 @default(false)
  mercadoPagoSubscriptionId    String?                 @unique
  mercadoPagoCheckoutKey       String?
  mercadoPagoCheckoutStartedAt DateTime?
  mercadoPagoCheckoutUrl       String?
  billingReconciledAt          DateTime?
  cancelAtPeriodEnd             Boolean                 @default(false)
  maxAppointmentsPerDay        Int?
  operationalStatus            ClinicOperationalStatus @default(ACTIVE)
  suspensionReason             String?
  suspendedAt                  DateTime?
  deletedAt                    DateTime?
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt
  memberships                  Membership[]
  customers                    Customer[]
  services                     Service[]
  appointments                 Appointment[]
  notifications                Notification[]
  businessHours                BusinessHour[]
  professionals                Professional[]
  paymentHistory               PaymentHistory[]
  billingContracts             BillingContract[]
  adminAuditLogs               AdminAuditLog[]
  invitations                  ClinicInvitation[]
  slugAliases                  ClinicSlugAlias[]
  financialEntries             FinancialEntry[]
  professionalAvailabilities   ProfessionalAvailability[]
  billingOwner                 Clinic?                 @relation("ClinicBillingUnits", fields: [billingOwnerId], references: [id], onDelete: Restrict)
  billingUnits                 Clinic[]                @relation("ClinicBillingUnits")

  @@index([billingOwnerId])
}

model AdminAuditLog {
  id              String   @id @default(uuid())
  actorAuthUserId String
  action          String
  targetType      String
  targetId        String
  reason          String?
  beforeSnapshot  Json?
  afterSnapshot   Json?
  requestId       String?
  ipAddress       String?
  clinicId        String?
  clinic          Clinic?  @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([actorAuthUserId, createdAt])
  @@index([clinicId, createdAt])
  @@index([targetType, targetId, createdAt])
}

model PaymentHistory {
  id                        String            @id @default(uuid())
  clinicId                  String
  clinic                    Clinic            @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  amount                    Decimal           @db.Decimal(10, 2)
  status                    String
  plan                      SubscriptionPlan?
  billingCycle              BillingCycle?
  mercadoPagoPaymentId      String?           @unique
  mercadoPagoSubscriptionId String?
  paidAt                    DateTime?
  periodEndsAt              DateTime?
  mercadoPagoInvoiceId      String?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  @@index([clinicId, createdAt])
}

model ClinicSlugAlias {
  id        String   @id @default(uuid())
  slug      String   @unique
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([clinicId])
}

model BillingContract {
  id                         String           @id
  clinicId                   String
  clinic                     Clinic           @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  plan                       SubscriptionPlan
  cycle                      BillingCycle
  amount                     Decimal          @db.Decimal(10, 2)
  currency                   String           @default("BRL")
  remotePlanId               String
  remoteId                   String?          @unique
  checkoutUrl                String?
  state                      String           @default("CREATING")
  lastReconciledAt            DateTime?
  reconciliationOffset       Int              @default(0)
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt

  @@index([clinicId, createdAt])
  @@index([lastReconciledAt])
}

model BusinessHour {
  id         String   @id @default(uuid())
  clinicId   String
  dayOfWeek  Int // 0 = Domingo, 1 = Segunda, ..., 6 = Sábado
  isOpen     Boolean  @default(true)
  openTime   String // "HH:mm"
  closeTime  String // "HH:mm"
  breakStart String? // "HH:mm"
  breakEnd   String? // "HH:mm"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  clinic     Clinic   @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  @@unique([clinicId, dayOfWeek])
  @@index([clinicId])
}

model User {
  id                   String             @id @default(uuid())
  authUserId           String?            @unique @db.Uuid
  legacyExternalUserId String?            @unique
  email                String?
  name                 String
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  trialStartedAt       DateTime?
  emailNotifications   Boolean            @default(true)
  weeklySummary        Boolean            @default(false)
  memberships          Membership[]
  sentInvitations      ClinicInvitation[] @relation("InvitationSender")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model ClinicInvitation {
  id              String           @id @default(uuid())
  clinicId        String
  email           String
  role            ClinicRole       @default(PROVIDER)
  status          InvitationStatus @default(PENDING)
  invitedByUserId String
  authUserId      String?          @db.Uuid
  professionalId  String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  clinic          Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  invitedBy       User             @relation("InvitationSender", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  professional    Professional?     @relation(fields: [professionalId], references: [id], onDelete: SetNull)

  @@index([email, status])
  @@index([clinicId, status])
  @@index([authUserId])
  @@index([professionalId])
}

model Membership {
  id           String        @id @default(uuid())
  role         ClinicRole    @default(PROVIDER)
  clinicId     String
  userId       String
  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  professional Professional?

  @@unique([clinicId, userId])
  @@index([userId])
}

model Customer {
  id           String        @id @default(uuid())
  name         String
  email        String?
  phone        String
  notes        String?
  tags         String[]      @default([])
  nextReturnAt DateTime?
  clinicId     String
  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([clinicId, phone])
  @@index([clinicId, name])
}

model Service {
  id            String                @id @default(uuid())
  name          String
  duration      Int
  price         Decimal               @db.Decimal(10, 2)
  imageUrl      String?
  isActive      Boolean               @default(true)
  clinicId      String
  clinic        Clinic                @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  appointments  Appointment[]
  professionals ProfessionalService[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([clinicId, isActive])
}

model Professional {
  id           String                @id @default(uuid())
  name         String
  imageUrl     String?
  isActive     Boolean               @default(true)
  clinicId     String
  membershipId String?               @unique
  clinic       Clinic                @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  membership   Membership?           @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  appointments Appointment[]
  invitations ClinicInvitation[]
  services     ProfessionalService[]
  availability ProfessionalAvailability[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([clinicId, isActive])
}

model ProfessionalAvailability {
  id             String       @id @default(uuid())
  clinicId       String
  professionalId String
  dayOfWeek      Int
  isOpen         Boolean      @default(true)
  openTime       String
  closeTime      String
  breakStart     String?
  breakEnd       String?
  clinic         Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([professionalId, dayOfWeek])
  @@index([clinicId])
}

model ProfessionalService {
  professionalId String
  serviceId      String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([professionalId, serviceId])
  @@index([serviceId])
}

model Appointment {
  id                String            @id @default(uuid())
  cancellationToken String            @unique @default(uuid())
  startTime         DateTime
  endTime           DateTime
  status            AppointmentStatus @default(PENDING)
  paymentMethod     PaymentMethod     @default(OTHER)
  priceAtBooking    Decimal           @db.Decimal(10, 2)
  totalPrice        Decimal           @db.Decimal(10, 2)
  paidAt            DateTime?
  notes             String?
  clinicId          String
  customerId        String
  serviceId         String
  professionalId    String?
  clinic            Clinic            @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  customer          Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  service           Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  professional      Professional?     @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  notifications     Notification[]
  financialEntries  FinancialEntry[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([clinicId, startTime])
  @@index([customerId, startTime])
  @@index([serviceId, startTime])
}

model FinancialEntry {
  id            String               @id @default(uuid())
  clinicId      String
  appointmentId String?
  type          FinancialEntryType
  status        FinancialEntryStatus @default(PENDING)
  description   String
  category      String?
  amount        Decimal              @db.Decimal(10, 2)
  paidAmount    Decimal              @default(0) @db.Decimal(10, 2)
  dueDate       DateTime?
  occurredAt    DateTime             @default(now())
  notes         String?
  clinic        Clinic               @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  appointment   Appointment?         @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([clinicId, occurredAt])
  @@index([clinicId, status, dueDate])
  @@index([appointmentId])
}

model Notification {
  id             String              @id @default(uuid())
  kind           NotificationKind
  channel        NotificationChannel
  status         NotificationStatus  @default(PENDING)
  recipient      String
  content        String
  idempotencyKey String              @unique
  scheduledFor   DateTime
  nextAttemptAt  DateTime
  sentAt         DateTime?
  attempts       Int                 @default(0)
  maxAttempts    Int                 @default(5)
  lockedAt       DateTime?
  error          String?
  providerRef    String?
  clinicId       String
  appointmentId  String
  clinic         Clinic              @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  appointment    Appointment         @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([status, scheduledFor])
  @@index([status, nextAttemptAt])
  @@index([clinicId, appointmentId])
}

model WebhookEvent {
  id              String   @id @default(uuid())
  provider        String
  eventId         String
  type            String
  payloadSnapshot Json?
  processedAt     DateTime @default(now())

  @@unique([provider, eventId])
  @@index([processedAt])
}

model RateLimit {
  id          String   @id @default(uuid())
  key         String
  windowStart DateTime
  count       Int      @default(0)
  resetAt     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, windowStart])
  @@index([key])
  @@index([resetAt])
}
