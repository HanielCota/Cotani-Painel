generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ClinicRole {
  ADMIN
  PROVIDER
  RECEPTIONIST
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELED
  NO_SHOW
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
  SMS
}

enum NotificationKind {
  CONFIRMATION
  REMINDER_24H
  REMINDER_2H
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  CANCELED
}

model Clinic {
  id            String         @id @default(uuid())
  clerkOrgId    String         @unique
  name          String
  slug          String         @unique
  timeZone      String         @default("America/Sao_Paulo")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  memberships   Membership[]
  customers     Customer[]
  services      Service[]
  appointments  Appointment[]
  notifications Notification[]
  businessHours BusinessHour[]
}

model BusinessHour {
  id         String   @id @default(uuid())
  clinicId   String
  dayOfWeek  Int // 0 = Domingo, 1 = Segunda, ..., 6 = Sábado
  isOpen     Boolean  @default(true)
  openTime   String // "HH:mm"
  closeTime  String // "HH:mm"
  breakStart String? // "HH:mm"
  breakEnd   String? // "HH:mm"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  clinic     Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, dayOfWeek])
  @@index([clinicId])
}

model User {
  id          String       @id @default(uuid())
  clerkUserId String       @unique
  email       String?
  name        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
}

model Membership {
  id        String     @id @default(uuid())
  role      ClinicRole @default(PROVIDER)
  clinicId  String
  userId    String
  clinic    Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([clinicId, userId])
  @@index([userId])
}

model Customer {
  id           String        @id @default(uuid())
  name         String
  email        String?
  phone        String
  clinicId     String
  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([clinicId, phone])
  @@index([clinicId, name])
}

model Service {
  id           String        @id @default(uuid())
  name         String
  duration     Int
  price        Decimal       @db.Decimal(10, 2)
  isActive     Boolean       @default(true)
  clinicId     String
  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([clinicId, isActive])
}

model Appointment {
  id          String            @id @default(uuid())
  startTime   DateTime
  endTime     DateTime
  status      AppointmentStatus @default(PENDING)
  notes       String?
  clinicId    String
  customerId  String
  serviceId   String
  clinic      Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  customer    Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  service     Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  notifications Notification[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([clinicId, startTime])
  @@index([customerId, startTime])
  @@index([serviceId, startTime])
}

model Notification {
  id             String              @id @default(uuid())
  kind           NotificationKind
  channel        NotificationChannel
  status         NotificationStatus  @default(PENDING)
  recipient      String
  content        String
  idempotencyKey String              @unique
  scheduledFor   DateTime
  nextAttemptAt  DateTime
  sentAt         DateTime?
  attempts       Int                 @default(0)
  maxAttempts    Int                 @default(5)
  lockedAt       DateTime?
  error          String?
  providerRef    String?
  clinicId       String
  appointmentId  String
  clinic         Clinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointment    Appointment         @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([status, scheduledFor])
  @@index([status, nextAttemptAt])
  @@index([clinicId, appointmentId])
}
